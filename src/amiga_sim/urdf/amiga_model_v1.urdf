        <mesh
          filename="package://amiga_sim/meshes/extra_tube_plate_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amiga_sim/meshes/extra_tube_plate_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="extra_tube_plate_e_joint"
    type="fixed">
    <origin
      xyz="0.602415 1.31441 0.78102"
      rpy="1.5708 -1.5708 1.5708" />
    <parent
      link="base_footprint" />
    <child
      link="extra_tube_plate_e_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link
    name="extra_tube_plate_f_link">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="0" />
      <inertia
        ixx="0"
        ixy="0"
        ixz="0"
        iyy="0"
        iyz="0"
        izz="0" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amiga_sim/meshes/extra_tube_plate_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://amiga_sim/meshes/extra_tube_plate_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="extra_tube_plate_f_joint"
    type="fixed">
    <origin
      xyz="0.602415 1.32741 0.78102"
      rpy="0 0 0" />
    <parent
      link="base_footprint" />
    <child
      link="extra_tube_plate_f_link" />
    <axis
      xyz="0 0 0" />
  </joint>


  <!-- Removed gazebo_ros_control; using gazebo_ros_diff_drive instead -->
  <transmission name="br_wheel_joint_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="br_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="br_wheel_joint_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="bl_wheel_joint_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="bl_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="bl_wheel_joint_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="fl_wheel_joint_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="fl_wheel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="fl_wheel_joint_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="fr_wheel_joint_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="fr_wheel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="fr_wheel_joint_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
   <gazebo reference="extra_tube_b_link">
    <material>Gazebo/Grey</material>
  </gazebo>
   <gazebo reference="extra_tube_c_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="extra_tube_d_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="long_extra_tube_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="extra_tube_plate_a_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="extra_tube_plate_b_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="extra_tube_plate_c_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="extra_tube_plate_d_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="extra_tube_plate_e_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="extra_tube_plate_f_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Diff drive plugin (uses /amiga/cmd_vel_unstamped) -->
  <gazebo>
    <plugin name="amiga_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50.0</updateRate>
      <robotNamespace>/</robotNamespace>
      <commandTopic>/amiga/cmd_vel_unstamped</commandTopic>
      <odometryTopic>/sim/skid_odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>wheel_center</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishTf>false</publishTf>
      <publishOdom>true</publishOdom>
      <publishWheelJointState>true</publishWheelJointState>
      <wheelSeparation>1.104</wheelSeparation>
      <wheelDiameter>0.432</wheelDiameter>
      <!-- y>0 joints are on the left in base_link frame -->
      <leftJoint>fr_wheel_joint</leftJoint>
      <leftJoint>fl_wheel_joint</leftJoint>
      <rightJoint>br_wheel_joint</rightJoint>
      <rightJoint>bl_wheel_joint</rightJoint>
      <wheelTorque>120.0</wheelTorque>
      <wheelAcceleration>5.0</wheelAcceleration>
      <commandTimeout>0.5</commandTimeout>
      <odometrySource>1</odometrySource>
      <publishOdomTF>true</publishOdomTF>
      <rosDebugLevel>na</rosDebugLevel>
    </plugin>
  </gazebo>

  <gazebo reference="oak_d_camera_2_tube_plate_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="oak_d_camera_2_mount_link">
